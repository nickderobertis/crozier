{
  "name": "llmlint-tooling",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "test-plugins": {
      "metadata": {
        "description": "llmlint: ignore[shell_test_tiers_stay_split] This suite drives only git, python3 and loopback servers on 127.0.0.1, which every leg carries and which reach no network; it installs nothing, and ran in 5 s (measured with `just nx run llmlint-tooling:test-plugins --skipNxCache`). A case that adds an install, a non-base host tool or a real network reach belongs in a split project, as llmlint-resolution and witness-search-git are."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/llmlint/tests/llmlint_plugins_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/llmlint-tooling/test-plugins/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/llmlint.yml",
        "{workspaceRoot}/llmlint-plugins/**/*",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/llmlint-tooling/test-plugins"
      ]
    },
    "test-diff": {
      "metadata": {
        "description": "llmlint: ignore[shell_test_tiers_stay_split] This suite drives only git, python3 and loopback servers on 127.0.0.1, which every leg carries and which reach no network; it installs nothing, and ran in 2 s (measured with `just nx run llmlint-tooling:test-diff --skipNxCache`). A case that adds an install, a non-base host tool or a real network reach belongs in a split project, as llmlint-resolution and witness-search-git are."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/llmlint/tests/llmlint_diff_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/llmlint-tooling/test-diff/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/llmlint-tooling/test-diff"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-plugins",
        "test-diff"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs llmlint-tooling"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/llmlint"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/llmlint"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/llmlint"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/llmlint"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    }
  }
}
