{
  "name": "llmlint-resolution",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/llmlint-resolution/tests/llmlint_resolution_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/llmlint-resolution/test/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/llmlint.yml",
        "{workspaceRoot}/llmlint-plugins/**/*",
        "{workspaceRoot}/tools/llmlint/tests/llmlint_plugins_test.py",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/justfile",
        {
          "env": "CROZIER_REQUIRE_LLMLINT"
        },
        {
          "runtime": "llmlint --version || echo llmlint-absent"
        },
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/llmlint-resolution/test"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs llmlint-resolution"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/llmlint-resolution"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/llmlint-resolution"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/llmlint-resolution"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/llmlint-resolution"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{workspaceRoot}/tools/llmlint/tests/*.py",
        "pythonTooling"
      ]
    }
  }
}
