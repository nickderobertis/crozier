  "platformLint": {
    "why": "Lint runs once on Linux. These are the only checks that read different code on another platform, so they alone also run in that platform's test lane; nothing else is repeated.",
    "windows": {
      "lint-windows": "clippy over crates with cfg(unix) or cfg(windows) gates: crozier, crozier-e2e, crozier-tool-journeys, ci, ci-journeys, pool-maintenance",
      "typecheck": "ty resolves sys.platform branches for the host, and tooling branches on win32 (reach_store.py, golden-reach-search.py, witness-search-recensus.py)"
    },
    "macos": {
      "lint-macos": "clippy over crozier-e2e, whose cfg(target_os = \"linux\") case compiles out on macOS; every other cfg in the tree is cfg(unix), the same code Linux reads"
    }
  },
