{
  "name": "surface-reach",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "measures:crozier-e2e",
    "lang:python"
  ],
  "implicitDependencies": [
    "crozier",
    "crozier-e2e"
  ],
  "targets": {
    "test-repin-composition": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/repin_composition_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-repin-composition/.coverage"
        }
      },
      "cache": true,
      "parallelism": false,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/*",
        "{workspaceRoot}/tools/witness-search/*.py",
        "{workspaceRoot}/tools/corpus/*.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/assets/scaffolding/metadata.json",
        "{workspaceRoot}/tests/fixtures/departures-ledger.tsv",
        "{workspaceRoot}/docs/fern-refusals/classes.tsv",
        "{workspaceRoot}/docs/openapi-surface/scenario-proof-index.tsv",
        "{workspaceRoot}/docs/openapi-surface/output-insensitive.tsv",
        "{workspaceRoot}/docs/openapi-surface/combination-cooccurrence.tsv",
        "{workspaceRoot}/docs/openapi-surface/witness-search-apis.guru/records.tsv",
        "{workspaceRoot}/docs/openapi-surface/witness-search-jentic/records.tsv",
        "{workspaceRoot}/docs/openapi-surface/witness-search-vendor-portals/records.tsv",
        "{workspaceRoot}/docs/openapi-surface/witness-search-portal-plan.tsv",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-repin-composition"
      ]
    },
    "test-fixtures-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/fixtures_coverage_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-fixtures-coverage/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/*",
        "crateTests",
        "e2eSource",
        "generator",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-fixtures-coverage"
      ]
    },
    "test-handwritten-reach": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/handwritten_reach_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-handwritten-reach/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/*",
        "crateTests",
        "e2eSource",
        "generator",
        "{workspaceRoot}/docs/openapi-surface/*.md",
        "{workspaceRoot}/docs/openapi-surface/*.tsv",
        "{workspaceRoot}/docs/openapi-surface/handwritten/**/*",
        "{workspaceRoot}/docs/openapi-surface/probe-expected/MANIFEST.tsv",
        "{workspaceRoot}/docs/openapi-surface/**/*.md",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-handwritten-reach"
      ]
    },
    "test-lock": {
      "metadata": {
        "description": "Every entry point that measures waits on the host-wide instrumented-measurement lock: the real `just` recipes and scripts over a scratch clone, with a stand-in `cargo` recording when a build would start."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/repin_lock_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-lock/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/*",
        "{workspaceRoot}/tools/witness-search/*.py",
        "{workspaceRoot}/tools/corpus/*.py",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-lock"
      ]
    },
    "test-llvm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/golden_reach_llvm_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-llvm/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/golden-reach.py",
        "{workspaceRoot}/rust-toolchain.toml",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-llvm"
      ]
    },
    "test-residual-attribution": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/surface-reach/tests/residual_attribution_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/surface-reach/test-residual-attribution/.coverage"
        }
      },
      "cache": true,
      "dependsOn": [
        "crozier:build"
      ],
      "inputs": [
        "default",
        "crateSource",
        "generator",
        "{workspaceRoot}/tools/surface-census/*",
        "{workspaceRoot}/tools/surface-census/tests/surface_census_test.py",
        "e2eSource",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/surface-reach/test-residual-attribution"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-repin-composition",
        "test-fixtures-coverage",
        "test-handwritten-reach",
        "test-lock",
        "test-llvm",
        "test-residual-attribution"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs surface-reach"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/surface-reach"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/surface-reach"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/surface-reach"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/surface-reach"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{workspaceRoot}/tools/surface-census/tests/*.py",
        "pythonTooling"
      ]
    }
  }
}
