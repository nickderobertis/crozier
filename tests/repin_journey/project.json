{
  "name": "repin-journey",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:tier",
    "cost:expensive",
    "tier:promoted",
    "lang:python"
  ],
  "targets": {
    "test-incremental": {
      "metadata": {
        "description": "`just census-repin` over a scratch clone of a pinned crozier commit, measured instrumented step by step. Its edges and inputs name only the tooling it drives, never the crate, whose sources the pinned commit fixes."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest tests/repin_journey/incremental_test.py"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/**/*",
        "{workspaceRoot}/tools/witness-search/*.py",
        "{workspaceRoot}/tools/corpus/*.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/rust-toolchain.toml",
        "pythonTooling"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-incremental"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs repin-journey"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tests/repin_journey"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tests/repin_journey"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tests/repin_journey"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tests/repin_journey"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{workspaceRoot}/tools/surface-census/*.py",
        "pythonTooling"
      ]
    }
  }
}
