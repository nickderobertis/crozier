{
  "openapi": "3.0.3",
  "info": {
    "title": "Harbor Ledger",
    "version": "1.0.0",
    "description": "Authored from scratch to measure whether declaring OpenAPI 3.1 rather than 3.0 moves any generated byte."
  },
  "servers": [
    {
      "url": "https://ledger.harbor.example"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Read the ledger's status",
        "responses": {
          "200": {
            "description": "The ledger's status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerStatus"
                }
              }
            }
          }
        }
      }
    },
    "/berths/{berthId}": {
      "get": {
        "operationId": "berths_getBerth",
        "tags": [
          "berths"
        ],
        "summary": "Read one berth",
        "parameters": [
          {
            "name": "berthId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The berth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Berth"
                }
              }
            }
          },
          "404": {
            "description": "No such berth"
          }
        }
      }
    },
    "/berths": {
      "get": {
        "operationId": "berths_listBerths",
        "tags": [
          "berths"
        ],
        "summary": "List the berths",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every berth",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Berth"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LedgerStatus": {
        "type": "object",
        "required": [
          "open"
        ],
        "properties": {
          "open": {
            "type": "boolean",
            "description": "Whether the ledger accepts entries."
          },
          "entries": {
            "type": "integer"
          }
        }
      },
      "Berth": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "length_m": {
            "type": "number",
            "description": "Berth length in metres."
          }
        }
      }
    }
  }
}
