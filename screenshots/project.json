{
  "name": "screenshots",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:tier",
    "cost:expensive",
    "tier:promoted"
  ],
  "metadata": {
    "description": "llmlint: ignore-file[new_projects_keep_the_graph_uniform] The screenshots project's capture and demo-gif generation needs `freeze` and the screencomp toolchain, which the check, sdk-env and live-e2e legs do not carry; a `build` target would pull that generation into every `--sweep` build fan-out; and its drift is gated separately by the visual-docs PR check."
  },
  "targets": {
    "capture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/screenshots.sh"
      },
      "cache": false,
      "inputs": [
        "default"
      ]
    },
    "demo-gif": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build --release --locked --bin crozier",
          "python3 screenshots/demo-gif.py"
        ],
        "parallel": false
      },
      "cache": false,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-project --with Pillow python3 screenshots/tests/demo_gif_test.py"
      },
      "cache": false,
      "inputs": [
        "default"
      ],
      "dependsOn": [
        {
          "projects": [
            "crozier"
          ],
          "target": "build"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs screenshots"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    }
  }
}
