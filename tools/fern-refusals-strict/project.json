{
  "name": "fern-refusals-strict",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "implicitDependencies": [
    "crozier"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/fern-refusals-strict/tests/fern_refusals_strict_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/fern-refusals-strict/test/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "crateSource",
        "generator",
        "{workspaceRoot}/tools/fern-refusals/fern-refusals.py",
        "{workspaceRoot}/tools/fern-refusals/tests/fern_refusals_test.py",
        "{workspaceRoot}/docs/fern-refusals/**/*",
        "{workspaceRoot}/docs/openapi-surface/fern-refusals/**/*",
        "witnessIndexReads",
        "{workspaceRoot}/tools/witness-search/witness-search-redo.py",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/fern-refusals-strict/test"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs fern-refusals-strict"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/fern-refusals-strict"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/fern-refusals-strict"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/fern-refusals-strict"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/fern-refusals-strict"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{workspaceRoot}/tools/fern-refusals/tests/*.py",
        "pythonTooling"
      ]
    }
  }
}
