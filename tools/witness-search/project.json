{
  "name": "witness-search",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "test-redo": {
      "metadata": {
        "description": "llmlint: ignore[shell_test_tiers_stay_split] This suite drives only just (the gate's own runner, a host tool), python3 and loopback servers on 127.0.0.1, which every leg carries and which reach no network; it installs nothing, and ran in 3 s (measured with `just nx run witness-search:test-redo --skipNxCache`). A case that adds an install, a non-base host tool or a real network reach belongs in a split project, as llmlint-resolution and witness-search-git are."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/witness-search/tests/witness_search_redo_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/witness-search/test-redo/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/surface-census/*.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/surface-census/tests/region_flip.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/witness-search/test-redo"
      ]
    },
    "test-acquisition": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/witness-search/tests/witness_search_acquisition_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/witness-search/test-acquisition/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/surface-census/*.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/surface-census/tests/region_flip.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/witness-search/test-acquisition"
      ]
    },
    "test-github": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/witness-search/tests/witness_search_github_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/witness-search/test-github/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/surface-census/*.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/surface-census/tests/region_flip.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/witness-search/test-github"
      ]
    },
    "test-screen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/witness-search/tests/witness_screen_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/witness-search/test-screen/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/surface-census/*.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/surface-census/tests/region_flip.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/witness-search/test-screen"
      ]
    },
    "test-rate-limit-guard": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/witness-search/tests/rate_limit_guard_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/witness-search/test-rate-limit-guard/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/rate_limit_guard.py",
        "{projectRoot}/tests/rate_limit_guard_test.py",
        "{workspaceRoot}/scripts/census-python.sh",
        "pythonTooling"
      ],
      "parallelism": false,
      "outputs": [
        "{workspaceRoot}/.coverage-data/witness-search/test-rate-limit-guard"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-redo",
        "test-acquisition",
        "test-github",
        "test-screen",
        "test-rate-limit-guard"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs witness-search"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/witness-search"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/witness-search"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/witness-search"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/witness-search"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{workspaceRoot}/tools/surface-census/tests/*.py",
        "pythonTooling"
      ]
    }
  }
}
