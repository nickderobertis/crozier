{
  "name": "ci-journeys",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:rust"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p crozier-ci-journeys -- --check"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt -p crozier-ci-journeys"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p crozier-ci-journeys --all-targets --all-features --locked -- -D warnings",
          "node scripts/check-project-boundaries.mjs ci-journeys"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "boundaries",
        "{workspaceRoot}/tools/ci/tests/support/release.rs",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo nextest run --locked -p crozier-ci-journeys",
          "node --test tools/ci-journeys/tests/gate.test.mjs tools/ci-journeys/tests/ci-tier.test.mjs tools/ci-journeys/tests/boundaries.test.mjs tools/ci-journeys/tests/release-guard.test.mjs tools/ci-journeys/tests/release-tail.test.mjs tools/ci-journeys/tests/selection.test.mjs tools/ci-journeys/tests/delivery-budget.test.mjs"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/tools/ci/tests/support/release.rs",
        "{workspaceRoot}/tools/ci/gate.mjs",
        "{workspaceRoot}/tools/ci/result-cache.mjs",
        "{workspaceRoot}/tools/ci/lanes.json",
        "{workspaceRoot}/tools/ci/lane-inventory.mjs",
        "{workspaceRoot}/tools/ci/suite-cases/pins/*",
        "{workspaceRoot}/tools/ci/ci-tier.mjs",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/scripts/check-project-boundaries.mjs",
        "{workspaceRoot}/tests/fixtures/openbanking.org.uk-account-info-openapi/**/*",
        "{workspaceRoot}/src/yaml.rs",
        "{workspaceRoot}/.github/workflows/*.yml",
        "{workspaceRoot}/scripts/release-branch-guard.mjs",
        "{workspaceRoot}/scripts/actions-budget-figures.sh",
        "{workspaceRoot}/scripts/reference-copies.json",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/.github/governance.json",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/pyproject.toml",
        "^production",
        {
          "runtime": "node tools/ci/project-files-digest.mjs"
        },
        "{workspaceRoot}/tools/ci/project-files-digest.mjs"
      ]
    },
    "lint-windows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p crozier-ci-journeys --all-targets --all-features --locked -- -D warnings"
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/tools/ci/tests/support/release.rs",
        "{workspaceRoot}/src/yaml.rs"
      ],
      "metadata": {
        "description": "This crate's cfg(unix)/cfg(windows) gates compile different code on Windows, so clippy there reads code `lint` on Linux never sees (tools/ci/lanes.json)."
      }
    }
  },
  "implicitDependencies": [
    "gate-timing"
  ]
}
