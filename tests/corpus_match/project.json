{
  "name": "corpus-match",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:tier",
    "cost:expensive",
    "tier:promoted",
    "lang:rust",
    "lane:live",
    "platform:linux"
  ],
  "targets": {
    "cold-registry-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tests/corpus_match/corpus_offline_test.py --cold-registry-build"
      },
      "cache": false,
      "inputs": [
        "crateSource",
        "default"
      ]
    },
    "test-cold-handoff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tests/corpus_match/cold_handoff_test.py"
      },
      "cache": false,
      "inputs": [
        "crateSource",
        "e2eSource",
        "default",
        "{workspaceRoot}/src/project.json",
        "{workspaceRoot}/crates/crozier-e2e/project.json"
      ]
    },
    "test-match": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tests/corpus_match/match.sh"
      },
      "cache": true,
      "inputs": [
        "crateSource",
        "e2eSource",
        "goldenReads",
        "generator",
        "default",
        "{workspaceRoot}/scripts/census-python.sh",
        "censusScripts",
        "witnessIndexReads"
      ],
      "dependsOn": [
        "cold-registry-build"
      ]
    },
    "test-strict": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tests/corpus_match/match.sh --strict"
      },
      "cache": true,
      "inputs": [
        "crateSource",
        "e2eSource",
        "goldenReads",
        "generator",
        "default",
        "{workspaceRoot}/scripts/census-python.sh",
        "censusScripts",
        "witnessIndexReads"
      ],
      "dependsOn": [
        "cold-registry-build"
      ]
    },
    "test-offline": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/ci/suite-cases/suite-cases.mjs check corpus-match-test-offline",
          "python3 tests/corpus_match/corpus_offline_test.py",
          "python3 tests/corpus_match/corpus_offline_recovery_test.py",
          "python3 tests/corpus_match/match_usage_test.py"
        ],
        "parallel": false,
        "env": {
          "CORPUS_OFFLINE_RECIPES": "goldens"
        }
      },
      "cache": false,
      "inputs": [
        "crateSource",
        "e2eSource",
        "goldenReads",
        "generator",
        "default",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/scripts/lib.sh",
        "{workspaceRoot}/tools/ci/suite-cases/**/*",
        "{workspaceRoot}/tests/census_fallback/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/tools/corpus/corpus-lib.sh",
        "{workspaceRoot}/tools/corpus/fetch-corpus.sh",
        "censusScripts",
        "witnessIndexReads"
      ],
      "parallelism": false,
      "dependsOn": [
        "cold-registry-build"
      ],
      "metadata": {
        "description": "The corpus byte-match recipes with sockets denied and no cache (CORPUS_OFFLINE_RECIPES=goldens); the census, refusal-class and fallback recipes are corpus-offline-tools:test, so a change to those tools reruns no golden comparison."
      }
    },
    "test": {
      "executor": "nx:noop",
      "metadata": {
        "description": "test-offline runs the real `just test-corpus-match` and `just test-corpus-match-strict`, so test-match and test-strict run inside it with sockets denied rather than a second time beside it (tools/ci/lanes.json records them there). Run either alone with its recipe."
      },
      "dependsOn": [
        "test-offline",
        "test-cold-handoff"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs corpus-match"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tests/corpus_match"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tests/corpus_match"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tests/corpus_match"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-certified-pair": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/fern-goldens/certified_pair.py check --within tests/corpus_match"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/assets/scaffolding/metadata.json",
        "{workspaceRoot}/tools/fern-goldens/certified_pair.py"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-certified-pair",
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tests/corpus_match"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    }
  }
}
