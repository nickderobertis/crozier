{
  "schema": 1,
  "plugins": [
    {
      "name": "base",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/base.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/base.llmlint.yml",
      "version": "1.13.0",
      "sha256": "9085d304632883bf3ca59441db3354c5e561ffa672d3811ee58dcbcd7b42f20e",
      "rules": [
        "agents_md_durable_and_terse",
        "boundary_inputs_validated",
        "changed_behavior_has_e2e",
        "comments_earn_their_place",
        "contracts_have_one_source_or_a_drift_gate",
        "diagnostics_error_or_absent",
        "e2e_not_mocked",
        "least_privilege_grants",
        "names_match_behavior",
        "new_code_lands_in_a_project",
        "no_hardcoded_secrets",
        "no_redundant_instruction_pointers",
        "suppressions_justified",
        "tests_assert_real_behavior",
        "tests_mirror_real_usage",
        "tool_output_is_signal",
        "work_goes_through_command_surface"
      ]
    },
    {
      "name": "shapes/cli",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/shapes/cli.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/shapes/cli.llmlint.yml",
      "version": "1.1.1",
      "sha256": "5ce58700b5386c431e1643a744504df19138888ee990252c6e11b52ee6059bb3",
      "rules": [
        "cli_output_contract",
        "new_command_or_client_gets_its_own_project"
      ]
    },
    {
      "name": "languages/rust",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/languages/rust.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/languages/rust.llmlint.yml",
      "version": "1.1",
      "sha256": "c8be339fdb689a10d727f8f5ebc07c68e829edb04b931ea3a22e63c2b95969a2",
      "rules": [
        "crates_stay_in_one_cargo_workspace",
        "invalid_states_unrepresentable",
        "no_panics_on_recoverable_errors"
      ]
    },
    {
      "name": "languages/bash",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/languages/bash.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/languages/bash.llmlint.yml",
      "version": "1.3.0",
      "sha256": "fb56e36418322389d3b42a48c2fa81937aa953a806ffd97d54e072193464572e",
      "rules": [
        "portable_to_target_shell",
        "robust_shell",
        "shell_test_tiers_stay_split"
      ]
    },
    {
      "name": "ci",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/ci.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/ci.llmlint.yml",
      "version": "1.5",
      "sha256": "d087a854539f9003cfc77a352f5096d5d43b9ec413676c76c27d4fb3c62fd160",
      "rules": [
        "ci_invokes_gate_recipe_not_inline_stages",
        "external_service_suite_stays_out_of_the_affected_tier",
        "live_tier_compiles_and_requires_credential",
        "no_second_broader_sweep_over_an_already_gated_commit",
        "no_untrusted_interpolation_in_run"
      ]
    },
    {
      "name": "releasing",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/releasing.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/releasing.llmlint.yml",
      "version": "1.1",
      "sha256": "81529255644e9ad3c402028ef6aa2a3cc59c01623fbc3f0f3fa673d672b3c394",
      "rules": [
        "release_does_not_regate_an_already_swept_commit"
      ]
    },
    {
      "name": "config-lint",
      "url": "https://raw.githubusercontent.com/nickderobertis/llmlint/main/assets/config_lint.yml",
      "pin": "1",
      "bundled": true,
      "captured_with_llmlint": "0.4.4",
      "rules": [
        "description_and_relevance_are_concise",
        "description_omits_already_excluded_situations",
        "description_yields_clear_verdict",
        "line_localizable_rules_require_attribution",
        "name_describes_what_the_rule_checks",
        "path_scoped_rules_use_files_not_relevance",
        "relevance_scopes_conditional_rules",
        "relevance_scopes_without_deciding_the_verdict"
      ]
    },
    {
      "name": "project-graph",
      "url": "https://raw.githubusercontent.com/nickderobertis/dero-skills/main/skills/bootstrap/create-repo/assets/llmlint/project-graph.llmlint.yml",
      "pin": "1",
      "file": "llmlint-plugins/project-graph.llmlint.yml",
      "version": "1.4.0",
      "sha256": "94e4fff36c87248987e48092d388c6e9cdc328d9c6eeb40cfcd8ff93e8c7e339",
      "rules": [
        "code_lands_in_the_domain_that_owns_it",
        "expensive_tests_stay_behind_their_own_edge",
        "instruction_layer_localized",
        "new_projects_keep_the_graph_uniform"
      ]
    }
  ]
}
