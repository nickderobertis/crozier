  "nonCheckWorkflows": {
    ".github/workflows/ci-caches.yml": "Writes the main-scoped caches the lint, test-linux and test-windows lanes restore. Runs no proof a pull request relies on, and gates nothing.",
    ".github/workflows/visual-docs-gallery.yml": "Publishes the gh-pages root gallery. The pull request's visual docs proof is a step of the lint lane.",
