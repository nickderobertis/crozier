{
  "openapi": "3.0.3",
  "info": {
    "title": "Pruning measurement",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://pruning.example.com"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "4XX": {
            "description": "problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RangeProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Reply": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        }
      },
      "RangeProblem": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}