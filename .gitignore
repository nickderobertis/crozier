/target
**/*.rs.bk
*.pdb

# llmlint / oneharness local state
.oneharness/
llmlint.buildout.yml

# gh-secrets local sync state (machine-local hashes; the manifest is committed,
# this is not). See gh-secrets.json.
/.gh-secrets-state.json

# Scratch output from local generation runs
/out
/.crozier-tmp
# LLVM profile dumps an instrumented binary writes into its working directory
# when run without LLVM_PROFILE_FILE (the coverage recipes always set it)
*.profraw

# Machine-local scratch: a deliberate re-fetch by tools/corpus/fetch-corpus.sh (golden
# rebuilds and source audits only — the committed copies under
# tests/fixtures/corpus-sources/ are what every gate reads) and measurement output.
/.local

# screencomp visual-docs: the committed digest baseline (shots/baseline/) and the
# README images (docs/screenshots/) ARE tracked; the regenerated capture trees and
# the rendered gallery are throwaway.
/shots/current
/shots/review
/site

# maturin / Python packaging build output (wheels + sdist)
/dist

# Python bytecode caches (the runtime wire tests import generated SDKs; a stray
# non-sandboxed run can drop these next to the imported modules / fixtures)
__pycache__/
*.pyc
.pytest_cache/

# The Nx orchestrator's install, its computation cache and the gate's logs.
# `just bootstrap` re-creates node_modules from the committed bun.lock.
/node_modules
/.nx
