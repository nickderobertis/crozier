{
  "name": "ci",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:rust"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p crozier-ci -- --check"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt -p crozier-ci"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p crozier-ci --all-targets --all-features --locked -- -D warnings",
          "node scripts/check-project-boundaries.mjs ci"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "boundaries",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo nextest run --locked -p crozier-ci"
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/.github/**/*",
        "{workspaceRoot}/scripts/release-branch-guard.mjs",
        "{workspaceRoot}/scripts/update-major-tag.sh",
        "{workspaceRoot}/scripts/install.sh",
        "{workspaceRoot}/tools/fern-goldens/weekly.py",
        "{workspaceRoot}/release-plz.toml",
        "{workspaceRoot}/budgets.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "lint-windows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p crozier-ci --all-targets --all-features --locked -- -D warnings"
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/src/yaml.rs"
      ],
      "metadata": {
        "description": "This crate's cfg(unix)/cfg(windows) gates compile different code on Windows, so clippy there reads code `lint` on Linux never sees (tools/ci/lanes.json)."
      }
    }
  }
}
