{
  "name": "golden-reach",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "measures:crozier-e2e",
    "lang:python"
  ],
  "targets": {
    "test-reach": {
      "metadata": {
        "description": "llmlint: ignore[shell_test_tiers_stay_split] This suite drives only git, python3 and loopback servers on 127.0.0.1, which every leg carries and which reach no network; it installs nothing, and ran in 89 s (measured with `just nx run golden-reach:test-reach --skipNxCache`). A case that adds an install, a non-base host tool or a real network reach belongs in a split project, as llmlint-resolution and witness-search-git are."
      },
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --locked --all-packages coverage erase",
          "uv run --locked --all-packages coverage run tools/golden-reach/tests/golden_reach_test.py",
          "uv run --locked --all-packages coverage combine --quiet"
        ],
        "parallel": false,
        "env": {
          "COVERAGE_FILE": ".coverage-data/golden-reach/test-reach/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "censusScripts",
        "crateTests",
        "e2eSource",
        "generator",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/fern-limitations.md",
        "{workspaceRoot}/docs/fern-refusals/**/*",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "witnessIndexReads",
        "{workspaceRoot}/tools/witness-search/witness-scrape-wide.py",
        "{workspaceRoot}/tools/witness-search/witness-search-redo.py",
        "{workspaceRoot}/tools/witness-search/witness-search-local-census.py",
        "{workspaceRoot}/tools/llmlint/llmlint-diff.py",
        "{workspaceRoot}/tools/fern-goldens/generate-fern-fixture.sh",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/golden-reach/test-reach"
      ]
    },
    "test-reach-portable": {
      "metadata": {
        "description": "llmlint: ignore[shell_test_tiers_stay_split] This suite drives only git, python3 and loopback servers on 127.0.0.1, which every leg carries and which reach no network; it installs nothing, and ran in 102 s (measured with `just nx run golden-reach:test-reach-portable --skipNxCache`). A case that adds an install, a non-base host tool or a real network reach belongs in a split project, as llmlint-resolution and witness-search-git are."
      },
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --locked --all-packages coverage erase",
          "uv run --locked --all-packages coverage run tools/golden-reach/tests/golden_reach_test.py",
          "uv run --locked --all-packages coverage combine --quiet"
        ],
        "parallel": false,
        "env": {
          "PYTHONPATH": "tools/golden-reach/tests/without-posix-modules",
          "COVERAGE_FILE": ".coverage-data/golden-reach/test-reach-portable/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "censusScripts",
        "crateTests",
        "e2eSource",
        "generator",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/docs/openapi-surface-coverage.md",
        "{workspaceRoot}/docs/fern-limitations.md",
        "{workspaceRoot}/docs/fern-refusals/**/*",
        "{workspaceRoot}/docs/corpus-licensing.md",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/tools/corpus/corpus_sources.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "witnessIndexReads",
        "{workspaceRoot}/tools/witness-search/witness-scrape-wide.py",
        "{workspaceRoot}/tools/witness-search/witness-search-redo.py",
        "{workspaceRoot}/tools/witness-search/witness-search-local-census.py",
        "{workspaceRoot}/tools/llmlint/llmlint-diff.py",
        "{workspaceRoot}/tools/fern-goldens/generate-fern-fixture.sh",
        "{workspaceRoot}/scripts/census-python.sh",
        "{workspaceRoot}/justfile",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/golden-reach/test-reach-portable"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-reach",
        "test-reach-portable"
      ]
    },
    "test-fixtures-coverage": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-reach",
        "test-reach-portable"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs golden-reach"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/golden-reach"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/golden-reach"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/golden-reach"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/golden-reach"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "censusScripts",
        "{workspaceRoot}/tools/corpus/*.py",
        "pythonTooling"
      ]
    }
  }
}
