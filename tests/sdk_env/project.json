{
  "name": "sdk-env",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:tier",
    "cost:expensive",
    "tier:promoted",
    "lang:rust"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo nextest run --locked -p crozier-e2e --run-ignored only -E \"test(/(^|::)sdk_env_/) and not test(=sdk_env_crozier_matches_fern_runtime_behavior)\""
      },
      "cache": false,
      "inputs": [
        "crateSource",
        "e2eSource",
        "goldenReads",
        "{workspaceRoot}/docs/fern-refusals/**/*",
        "{workspaceRoot}/tests/runtime/**/*",
        "generator",
        "default",
        "{workspaceRoot}/tools/fern-refusals/fern-refusals.py",
        "{workspaceRoot}/tools/fern-refusals/sdk_evaluation.py",
        "{workspaceRoot}/tools/fern-refusals/sdk_evaluation_runtime.py",
        "{workspaceRoot}/.ruff-version"
      ],
      "dependsOn": [
        {
          "projects": [
            "crozier"
          ],
          "target": "build"
        }
      ]
    },
    "lint-certified-pair": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/fern-goldens/certified_pair.py check --within tests/sdk_env"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/assets/scaffolding/metadata.json",
        "{workspaceRoot}/tools/fern-goldens/certified_pair.py"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "lint-certified-pair"
      ],
      "options": {
        "command": "node scripts/check-project-boundaries.mjs sdk-env"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    }
  }
}
