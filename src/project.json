{
  "name": "crozier",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "type:crate",
    "lang:rust"
  ],
  "metadata": {
    "cargoManifestDir": "."
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p crozier -- --check"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt -p crozier"
        }
      },
      "cache": true,
      "inputs": [
        "crateTests"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p crozier --all-targets --all-features --locked -- -D warnings",
          "node scripts/check-project-boundaries.mjs crozier"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "crateTests",
        "crateTestReads",
        "boundaries"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build -p crozier --bin crozier --locked"
      },
      "cache": false,
      "inputs": [
        "crateSource"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node scripts/share-instrumented-build.mjs",
          "cargo llvm-cov clean --profraw-only",
          "cargo llvm-cov --locked --no-report nextest -p crozier"
        ],
        "parallel": false,
        "env": {
          "CARGO_LLVM_COV_TARGET_DIR": "target/llvm-cov-gate"
        }
      },
      "cache": true,
      "inputs": [
        "crateTestRun",
        "{workspaceRoot}/scripts/share-instrumented-build.mjs"
      ]
    },
    "lint-windows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p crozier --all-targets --all-features --locked -- -D warnings"
      },
      "cache": true,
      "inputs": [
        "crateTests",
        "crateTestReads"
      ],
      "metadata": {
        "description": "This crate's cfg(unix)/cfg(windows) gates compile different code on Windows, so clippy there reads code `lint` on Linux never sees (tools/ci/lanes.json)."
      }
    }
  }
}
