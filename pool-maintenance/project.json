{
  "name": "pool-maintenance",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:rust",
    "lang:bash"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p crozier-pool-maintenance -- --check"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt -p crozier-pool-maintenance"
        }
      },
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p crozier-pool-maintenance --all-targets --all-features --locked -- -D warnings",
          "node scripts/check-project-boundaries.mjs pool-maintenance"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "boundaries"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo nextest run --locked -p crozier-pool-maintenance"
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/justfile",
        {
          "runtime": "cargo-prune-superseded --version"
        }
      ]
    },
    "budgets-host": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx onebudgetspec check pool-maintenance/budgets.yaml --label host"
      }
    }
  }
}
