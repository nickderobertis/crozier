{
  "name": "fern-refusals",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/fern-refusals/tests/fern_refusals_test.py"
      },
      "cache": true,
      "inputs": [
        "default",
        "crateSource",
        "generator",
        "{workspaceRoot}/docs/fern-refusals/**/*",
        "{workspaceRoot}/docs/openapi-surface/**/*",
        "{workspaceRoot}/tests/fixtures/CORPUS.md",
        "{workspaceRoot}/tools/witness-search/witness-search-github.py",
        "{workspaceRoot}/tools/witness-search/witness-search-github-index.py",
        "{workspaceRoot}/tools/witness-search/witness_screen.py",
        "{workspaceRoot}/tools/witness-search/rate_limit_guard.py",
        "{workspaceRoot}/tools/witness-search/witness-search-redo.py",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/tools/surface-census/witness-search-region-keys.py",
        "{workspaceRoot}/tools/surface-census/tests/surface_census_test.py",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/justfile"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs fern-refusals"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    }
  }
}
