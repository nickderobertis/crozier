{
  "name": "ci-journeys",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:rust"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p crozier-ci-journeys -- --check"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt -p crozier-ci-journeys"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo clippy -p crozier-ci-journeys --all-targets --all-features --locked -- -D warnings",
          "node scripts/check-project-boundaries.mjs ci-journeys"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "boundaries",
        "{workspaceRoot}/tools/ci/tests/support/release.rs",
        "{workspaceRoot}/src/yaml.rs"
      ]
    },
    "test": {
      "metadata": {
        "description": "llmlint: ignore[new_command_or_client_gets_its_own_project] This observation-only dispatch explicitly forbids restructuring CI or test suites and requires ci/ci-journeys checks; the timing CLI extends the existing gate driver boundary. llmlint: ignore[expensive_tests_stay_behind_their_own_edge] The gate now imports timing calculations, so this input is a real dependency of existing gate journeys; removing it would cache stale results. Project isolation is outside the authorized no-restructuring scope."
      },
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo nextest run --locked -p crozier-ci-journeys",
          "node --test tools/ci-journeys/tests/gate.test.mjs tools/ci-journeys/tests/ci-tier.test.mjs tools/ci-journeys/tests/boundaries.test.mjs"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "cargo",
        "{workspaceRoot}/.github/workflows/release.yml",
        "{workspaceRoot}/tools/ci/tests/support/release.rs",
        "{workspaceRoot}/tools/ci/gate.mjs",
        "{workspaceRoot}/tools/ci/gate-timing.mjs",
        "{workspaceRoot}/tools/ci/ci-tier.mjs",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/scripts/check-project-boundaries.mjs",
        "{workspaceRoot}/tests/fixtures/openbanking.org.uk-account-info-openapi/**/*",
        "{workspaceRoot}/src/yaml.rs",
        "{workspaceRoot}/.github/macos-policy.mjs",
        "{workspaceRoot}/.github/require-ci-results.mjs"
      ]
    }
  }
}
