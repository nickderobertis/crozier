{
  "name": "screenshots",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:tier",
    "cost:expensive",
    "tier:promoted"
  ],
  "implicitDependencies": [
    "crozier"
  ],
  "targets": {
    "capture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/screenshots.sh"
      },
      "cache": false,
      "inputs": [
        "default",
        "crateSource",
        "generator",
        "{workspaceRoot}/scripts/screenshots.sh",
        "{workspaceRoot}/screencomp.toml",
        "{workspaceRoot}/.freeze-version"
      ]
    },
    "demo-gif": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build --release --locked --bin crozier",
          "python3 screenshots/demo-gif.py"
        ],
        "parallel": false
      },
      "cache": false,
      "inputs": [
        "default",
        "crateSource",
        "generator",
        "{workspaceRoot}/scripts/screenshots.sh",
        "{workspaceRoot}/screencomp.toml",
        "{workspaceRoot}/.freeze-version"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs screenshots"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    }
  }
}
