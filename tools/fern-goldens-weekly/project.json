{
  "name": "fern-goldens-weekly",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/fern-goldens-weekly/tests/weekly_journeys_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/fern-goldens-weekly/test/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "crateSource",
        "{workspaceRoot}/tools/fern-goldens/weekly.py",
        "{workspaceRoot}/tools/fern-goldens/fern-references.py",
        "{workspaceRoot}/tools/fern-goldens/fern-goldens",
        "{workspaceRoot}/tools/fern-goldens/generate-fern-fixture.sh",
        "{workspaceRoot}/tools/fern-goldens/golden_overlay.py",
        "{workspaceRoot}/tools/fern-goldens/certified_pair.py",
        "{workspaceRoot}/tools/fern-refusals/fern-refusals.py",
        "{workspaceRoot}/tools/corpus/corpus-lib.sh",
        "{workspaceRoot}/tools/corpus/corpus_remote_ref_pins.py",
        "{workspaceRoot}/tools/corpus/fetch-corpus.sh",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/scripts/lib.sh",
        "{workspaceRoot}/assets/scaffolding/metadata.json",
        "{workspaceRoot}/tests/fixtures/corpus-aliases.tsv",
        "{workspaceRoot}/tests/fixtures/corpus-remote-ref-pins.tsv",
        "{workspaceRoot}/docs/fern-refusals/classes.tsv",
        "{workspaceRoot}/docs/fern-refusals/findings.tsv",
        "{workspaceRoot}/docs/fern-refusals/default-not-enum-value/probe.yml",
        "{workspaceRoot}/tests/fixtures/calorieninjas.com/known-fern-failure.json",
        "pythonTooling"
      ],
      "dependsOn": [
        "crozier:build"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/fern-goldens-weekly/test"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs fern-goldens-weekly"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/fern-goldens-weekly"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/fern-goldens-weekly"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/fern-goldens-weekly"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/fern-goldens-weekly"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    }
  }
}
