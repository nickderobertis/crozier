{
  "name": "github-workflows",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:javascript"
  ],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun install --cwd .github --frozen-lockfile"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test .github/tests/*.test.mjs"
      },
      "dependsOn": [
        "install"
      ],
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/screencomp.toml",
        "{workspaceRoot}/release-plz.toml",
        "{workspaceRoot}/scripts/release-native.py"
      ]
    },
    "budgets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node .github/check-budgets.mjs"
      },
      "dependsOn": [
        "test"
      ],
      "cache": false,
      "inputs": [
        "default"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node .github/check-syntax.mjs",
          "node .github/lint-workflows.mjs",
          "node scripts/check-project-boundaries.mjs github-workflows"
        ],
        "parallel": false
      },
      "dependsOn": [
        "budgets"
      ],
      "cache": false,
      "inputs": [
        "default",
        "boundaries"
      ]
    }
  }
}
