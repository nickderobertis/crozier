{
  "name": "corpus",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:tooling",
    "lang:python"
  ],
  "targets": {
    "lint-sources": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/corpus/corpus_sources.py check"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/corpus_sources.py",
        "{projectRoot}/corpus_remote_ref_pins.py",
        "{workspaceRoot}/tests/fixtures/**/*"
      ]
    },
    "lint-remote-ref-pins": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/corpus/corpus_remote_ref_pins.py check"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/corpus_remote_ref_pins.py",
        "{workspaceRoot}/tests/fixtures/**/*"
      ]
    },
    "lint-licence-rescreening": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tools/corpus/licence-rescreening-check.py"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/licence-rescreening-check.py",
        "{workspaceRoot}/docs/licence-rescreening.md",
        "{workspaceRoot}/docs/openapi-surface/*.md"
      ]
    },
    "lint-boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-project-boundaries.mjs corpus"
      },
      "cache": true,
      "inputs": [
        "boundaries"
      ]
    },
    "test-sources": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/corpus/tests/corpus_sources_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/corpus/test-sources/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/lib.sh",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/tests/fixtures/**/*",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/corpus/test-sources"
      ]
    },
    "test-remote-ref-pins": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/corpus/tests/corpus_remote_ref_pins_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/corpus/test-remote-ref-pins/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/docs/openapi-surface/witness-search-github-publisher-trees/pinned-members.tsv",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/corpus/test-remote-ref-pins"
      ]
    },
    "test-licence-rescreening": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages pytest --cov --cov-report= tools/corpus/tests/licence_rescreening_test.py",
        "env": {
          "COVERAGE_FILE": ".coverage-data/corpus/test-licence-rescreening/.coverage"
        }
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/lib.sh",
        "{workspaceRoot}/tools/surface-census/openapi-surface-census.py",
        "{workspaceRoot}/tests/fixtures/**/*",
        "{workspaceRoot}/justfile",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/docs/openapi-surface/*.md",
        "pythonTooling"
      ],
      "outputs": [
        "{workspaceRoot}/.coverage-data/corpus/test-licence-rescreening"
      ]
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-sources",
        "test-remote-ref-pins",
        "test-licence-rescreening"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff format --check tools/corpus"
      },
      "configurations": {
        "write": {
          "command": "uv run --locked --all-packages ruff format tools/corpus"
        }
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint-ruff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ruff check tools/corpus"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint-sources",
        "lint-remote-ref-pins",
        "lint-licence-rescreening",
        "lint-boundaries",
        "lint-ruff"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --all-packages ty check tools/corpus"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.py",
        "pythonTooling"
      ]
    }
  }
}
